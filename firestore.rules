rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read for products catalog & store settings
    // Allow write for admins / atelier management
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: Allow customers to create orders & read orders, and admin to update
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
